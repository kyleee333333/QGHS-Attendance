# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Access database (Windows host only)
ACCESS_DB_PATH=C:\\qghs-connect\\database\\qghs-connect.accdb
ACCESS_ODBC_DRIVER=Microsoft Access Driver (*.mdb, *.accdb)
ACCESS_DB_PASSWORD=replace-with-a-local-secret

# Authentication - generate strong random values locally
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL_SECONDS=900

# Field encryption: 32-byte key encoded as 64 hex characters
FIELD_ENCRYPTION_KEY=replace-with-64-hex-characters

# Email (optional during development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QGHS CONNECT <noreply@example.test>
EMAIL_WORKER_INTERVAL_MS=30000
